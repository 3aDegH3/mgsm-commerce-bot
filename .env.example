# ==========================================
# General
# ==========================================
COMPOSE_PROJECT_NAME=mgsm
APP_ENV=development
APP_TIME_ZONE=Asia/Tehran
LOG_LEVEL=INFO

# ==========================================
# Django Core API
# ==========================================
DJANGO_SECRET_KEY=replace-with-a-secure-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,core-api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_DB=mgsm
POSTGRES_USER=mgsm
POSTGRES_PASSWORD=replace-with-a-secure-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================================
# Redis
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ==========================================
# Celery
# ==========================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==========================================
# Telegram Bot
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=

# Development: polling
# Production: webhook
TELEGRAM_BOT_MODE=polling
TELEGRAM_WEBHOOK_BASE_URL=

# ==========================================
# Website Payment Bridge
# ==========================================
PAYMENT_BRIDGE_BASE_URL=
PAYMENT_BRIDGE_API_KEY=
PAYMENT_BRIDGE_WEBHOOK_SECRET=
PAYMENT_CALLBACK_BASE_URL=http://localhost:8000

# مدت اعتبار لینک پرداخت، بر حسب دقیقه
PAYMENT_SESSION_TTL_MINUTES=30

# ==========================================
# Security
# ==========================================
DATA_ENCRYPTION_KEY=replace-with-a-secure-encryption-key
INTERNAL_API_KEY=replace-with-a-secure-internal-api-key
