# General
COMPOSE_PROJECT_NAME=mgsm
APP_ENV=development
DEBUG=true

# Django
DJANGO_SECRET_KEY=replace-with-a-secure-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=mgsm
POSTGRES_USER=mgsm
POSTGRES_PASSWORD=replace-with-a-secure-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=

# WooCommerce
WOOCOMMERCE_BASE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_WEBHOOK_SECRET=
